{"file":"Merit Aktiva for AI Agents-0.1.0-v2.zip","bytes":95310,"status":"已读取","plugins":[{"path":".claude-plugin/plugin.json","name":"merit-aktiva-skills","description":"Merit Aktiva for AI agents — Claude Code skills for Estonian bookkeeping, invoicing, VAT (KMD), and the Merit Aktiva REST API.","version":"0.1.0","license":"MIT","repository":"https://github.com/arturl95/merit-aktiva-skills","homepage":"https://github.com/arturl95/merit-aktiva-skills"}],"skills":[{"path":"skills/estonian-bookkeeping/SKILL.md","name":"estonian-bookkeeping","description":"Apply current (2026) Estonian tax rules — VAT (käibemaks) 24/13/9, distributed-profit CIT 22/78, payroll taxes, KMD codes, fringe benefits, security tax status. Use for any Estonian bookkeeping decision (with or without Merit Aktiva).","headings":["estonian-bookkeeping","When to use","2026 rate cheatsheet","Security tax (julgeolekumaks)","Transaction → account → KMD code cheatsheet","Verify-before-filing rule","When to read each reference","Cross-references"],"name_hint":"estonian · bookkeeping"},{"path":"skills/merit-aktiva-core/SKILL.md","name":"merit-aktiva-core","description":"Authenticate and call the Merit Aktiva REST API — HMAC-SHA256 query-string signing, request conventions, rate limits, error handling. Use before any other Merit skill in this plugin.","headings":["merit-aktiva-core","When to use","Credentials","Base URLs","Signing recipe (4 lines)","Request envelope","The 5 errors you will hit","Rate limits","When to read each reference","Guardrails","Cross-references"],"name_hint":"merit · aktiva · core"},{"path":"skills/merit-aktiva-ledger-reports/SKILL.md","name":"merit-aktiva-ledger-reports","description":"Create general-ledger journal entries (sendglbatch) and pull P&L (getprofitrep), balance sheet (getbalancerep), customer-debt (getcustdebtrep), sales (getsalesrep), and inventory reports from Merit Aktiva. Use for month-end adjustments and reporting.","headings":["merit-aktiva-ledger-reports","When to use","GL rules (cast-iron)","`sendglbatch` happy path","Confirmation guardrail","The four most-used reports","`getprofitrep` — P&L (income statement)","`getbalancerep` — Financial position (balance sheet)","`getcustdebtrep` — Customer debts (AR aging)","`getsalesrep` — Sales report","Pre-flight","Common GL patterns","Monthly depreciation","Accrued expenses (month-end)","VAT control reconciliation","When to read each reference","Cross-references"],"name_hint":"merit · aktiva · ledger · reports"},{"path":"skills/merit-aktiva-masters/SKILL.md","name":"merit-aktiva-masters","description":"Look up and create Merit Aktiva customers, vendors, items, tax codes, and chart-of-accounts entries. Use to resolve names to GUIDs before posting transactions, or to onboard new master data.","headings":["merit-aktiva-masters","When to use","Cache-once-per-session rule","Flags you must know","Customers — `NotTDCustomer`","Vendors — `VatAccountable`","Broad-search gotcha","Minimum examples","Create a customer","Create a vendor","Create a service item","Guardrails","When to read each reference","Cross-references"],"name_hint":"merit · aktiva · masters"},{"path":"skills/merit-aktiva-purchases-payments/SKILL.md","name":"merit-aktiva-purchases-payments","description":"Post purchase invoices and expense claims, record payments, and import bank statements (camt.053) in Merit Aktiva. Use when entering supplier bills, paying invoices, or reconciling bank transactions.","headings":["merit-aktiva-purchases-payments","When to use","Pre-flight (every call)","`sendpurchinvoice` happy path","Expense claim","Approval queue — `sendpurchorder`","Payment rules","`sendpayment` (for sales invoices) and `sendPaymentV` (for purchase invoices)","Partial payments","Bank statement import","Confirmation guardrail","When to read each reference","Cross-references"],"name_hint":"merit · aktiva · purchases · payments"},{"path":"skills/merit-aktiva-sales/SKILL.md","name":"merit-aktiva-sales","description":"Create, 