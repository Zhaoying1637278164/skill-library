re published.","headings":["Social publishing","Safety contract","Prerequisites","Mandatory routing","Publish workflow"],"name_hint":"social · publishing","description_zh":"将 Riverside 片段发布、上传、分享或定时发布到已连接的 YouTube、Shorts、TikTok、Instagram、Facebook、LinkedIn 或 X；不用于剪辑、账号连接管理或发布后的帖子管理。"},{"path":"skills/video-editing/SKILL.md","name":"video-editing","description":"Use when the user wants to cut, trim, clean up, caption, lay out, crop, brand, add overlays, stock media or music to, or otherwise change the content of a Riverside edit, or to turn a raw recording into an editable edit. Not for browsing or searching existing content (see content-discovery), and not for publishing to social platforms (see social-publishing). If the question is whether an editing error is really an authentication or connection problem, use setup first.","headings":["Video editing","Three rules that override everything","Time axes — read before computing any time","Read the guide, then follow the guide","Prefer the dedicated tool over batch","Transcript handles fail closed","Handing an edit off to publishing","Where to read next"],"name_hint":"视频 · editing","description_zh":"创建可编辑 Riverside 项目或修改现有编辑内容，支持剪切、修整、清理、字幕、布局、裁切、品牌、叠加层、素材与音乐；内容检索和社交发布另用专用技能，疑似认证故障先排查连接。"}],"commands":[],"readmes":[{"path":"README.md","headings":["Riverside Plugin for Claude Code, Cursor, ChatGPT, and Codex","Installation","Cursor","ChatGPT and Codex","What You Can Do","Search and Content Discovery","Video Editing","Social Publishing","Requirements","Authentication","Support & Security","Privacy","License"]}],"mcp_servers":["riverside","riverside"],"config_names":[],"paths":[".claude-plugin/plugin.json",".codex-plugin/plugin.json",".cursor-plugin/plugin.json",".github/workflows/validate.yml",".gitignore",".mcp.json","CHANGELOG.md","LICENSE","README.md","SECURITY.md","agents/openai.yaml","assets/logo.png","docs/cursor-testing.md","expected-tools.txt","mcp.json","plugin.json","schemas/agent-plugins/1.0.0/mcp.schema.json",