{"file":"Turbocharge-2.8.1-v2.zip","bytes":92143,"status":"已读取","plugins":[{"path":".claude-plugin/plugin.json","name":"turbocharge","displayName":"Turbocharge","description":"Engineering team orchestration for Claude Code. 10 skills, 5 agents, 1 hook — single pipeline from brainstorm to shipped code.","version":"2.8.1","license":"MIT","repository":"https://github.com/nicodiansk/turbocharge","homepage":"https://github.com/nicodiansk/turbocharge","keywords":["orchestration","agents","tdd","code-review","product-development","workflow","team"]}],"skills":[{"path":"skills/atlas/SKILL.md","name":"atlas","description":"Generate or update a semantic domain map (ATLAS.md) for the project. Maps where to look, entry points, module purposes, key symbols, and integration points. Complements codemap's structural index with the domain knowledge layer.","headings":["Atlas — Project Domain Map","The Iron Law","Step 1: Detect Mode","Step 2: Read the Codebase","Step 2b: Read Codemap Index (if available)","Step 3: Generate or Update","Generate Mode (no ATLAS.md)","Update Mode (ATLAS.md exists)","Step 4: ATLAS.md Format","ATLAS — [Project Name]","Where to Look","Entry Points","Module Map","Key Symbols","Integration Points","Conventions & Gotchas","Step 5: Write Staleness Hash","What NOT to Include"],"name_hint":"atlas"},{"path":"skills/brainstorm/SKILL.md","name":"brainstorm","description":"Use when starting creative work - creating features, building components, adding functionality, or modifying behavior. Explores requirements through Socratic dialogue before any implementation.","headings":["Brainstorm","The Iron Law","Process","1. Understand Context","2. Discover Requirements","3. Explore Approaches","4. Present Design","5. Save and Continue","Red Flags — STOP","Workflow Position"],"name_hint":"brainstorm"},{"path":"skills/build/SKILL.md","name":"build","description":"Use when you have an implementation plan ready to execute. Dispatches builder agents (Sonnet) per task with self-review. Opt-in review (single Sonnet task-reviewer, two verdicts) for high-risk tasks. Supports single-track and multi-track parallel execution.","headings":["Build","The Iron Law","Step 1: Load and Review Plan","Step 2: Choose Execution Mode","Step 3: Execute — Standard","3a. Dispatch Builder","3b. Mark Task Complete","3c. After Batch (every N tasks, default 3)","Step 4: Execute — Reviewed","4a. Dispatch Task Reviewer","4b. Dispatch Researcher (on demand)","4c. Mark Task Complete","4d. After Batch (every N tasks, default 3)","Step 5: Execute — Multi-Track (Agent Teams)","5a. Confirm with User","5b. Spawn Teammates","Step 6: Complete","Red Flags — STOP"],"name_hint":"构建"},{"path":"skills/debug/SKILL.md","name":"debug","description":"Use when encountering any bug, test failure, or unexpected behavior. Enforces systematic root-cause investigation before proposing fixes. Prevents guess-and-check debugging.","headings":["Systematic Debugging","Overview","The Iron Law","The Four Phases","Phase 1: Root Cause Investigation","Phase 2: Pattern Analysis","Phase 3: Hypothesis and Testing","Phase 4: Implementation","Red Flags — STOP and Return to Phase 1","Quick Reference","Integration","Verification Checklist"],"name_hint":"排错"},{"path":"skills/plan/SKILL.md","name":"plan","description":"Use when you have stories or clear requirements that need to become an implementation plan with bite-sized tasks, exact file paths, complete code, and verification commands.","headings":["Create Implementation Plan","Plan Document Header","[Feature Name] Implementation Plan","Context Gathering","Task Structure","Task N: [Component Name]","Rules","Save"],"name_hint":"规划"},{"path":"skills/review/SKILL.md","name":"review","description":"Use before merging to verify completed work meets requirements and quality standards. Dispatches code-reviewer for holistic assessment of the full git diff against the original plan.","headings":["Code Review","The Iron Law","Context","Your Review","Red Flags — Rationalizations That Mean You're Doing a Shallow Review","Review Completeness Checklist"],"name_hint":"评审"},{"path":"skills/setup/SKILL.md","name":"setup","description":"Run once after installing turbocharge. Audits global config for conflicts — duplicate agents, competing skills, stale rules — and offers to fix them. Also validates turbocharge plugin health.","headings":["Setup Turbocharge","The Goal","Audit Steps","1. Check for Competing Agents","2. Check for Duplicate Skills/Commands","3. Check agents.md Rule","Agent Orchestration","Primary System: Turbocharge Plugin","4. Check for Plugin Conflicts","5. Validate Turbocharge Plugin Health","6. Check Global Rules Alignment","7. Check for Global Rules / Turbocharge Overlap","CLAUDE.md Phase","1. Auto-Detect (no questions)","2. Interview (≤5 questions, each skippable)","3. Render and Append","4. Show Diff, Confirm, Write","5. Size Guard"],"name_hint":"设置"},{"path":"skills/ship/SKILL.md","name":"ship","description":"Use when implementation and review are complete and you need to integrate the work. Verifies tests, presents structured options for merge, PR, keep, or discard, and handles cleanup.","headings":["Ship","Step 1: Verify Tests","Run project's test suite","Step 2: Determine Base Branch","Step 3: Present Options","Step 4: Execute Choice","Option 1: Merge Locally","Verify tests on merged result","Option 2: Push and Create PR","Summary","Test Plan","Option 3: Keep As-Is","Option 4: Discard","Step 5: Cleanup Worktree (Options 1, 2, 4)","If in worktree:","Workflow Position"],"name_hint":"ship"},{"path":"skills/story/SKILL.md","name":"story","description":"Use when you have requirements, PRDs, or feature descriptions that need to become implementable work. Transforms requirements into INVEST-compliant user stories with testable acceptance criteria.","headings":["Story Breakdown","The Iron Law","INVEST Criteria","Epic Template","Epic: [Name]","Problem Statement","Success Metrics","Scope","In Scope","Out of Scope","Stories","Dependencies","Risks","Story Template","Story: [Title]","Acceptance Criteria","Criterion 1: [Name]","Criterion 2: [Name]"],"name_hint":"story"},{"path":"skills/wrap/SKILL.md","name":"wrap","description":"Use when ending a session, taking a break, or context is getting full. Captures session state, decisions, and generates a resume prompt for the next session. Critical for multi-session continuity.","headings":["Wrap Session","The Iron Law","What to Capture","1. Progress","2. Decisions","3. Blockers & Open Questions","4. Next Steps","5. Resume Prompt","5.5. Atlas + CodeMap Freshness (MANDATORY)","6. Encode Session Learnings","7. Write Memory With Confidence Metadata","8. 200-Line Cap on MEMORY.md — prune-before-build","9. Session Snapshot JSON","How to Deliver","Workflow Position"],"name_hint":"wrap"}],"commands":[],"readmes":[{"path":"README.md","headings":["Install","The Pipeline","Why a Pipeline","How Build Works","Agents","Hooks","Quick Start Examples","Full pipeline from scratch","Jump to planning with existing requirements","Debug a specific issue","Wrap up your session","What to Remove After Installing","Project Structure","Validate","License"]}],"mcp_servers":[],"config_names":[],"paths":[".claude-plugin/marketplace.json",".claude-plugin/plugin.json",".gitattributes",".github/workflows/claude-code-review.yml",".github/workflows/claude.yml",".gitignore","CHANGELOG.md","CLAUDE.md","LICENSE","README.md","agents/builder.md","agents/code-reviewer.md","agents/planner.md","agents/researcher.md","agents/task-reviewer.md","examples/brainstorm-output.md","examples/plan-output.md","examples/story-output.md","examples/wrap-output.md","hooks/hooks.json","hooks/missing-atlasmd-nudge.md","hooks/missing-claudemd-nudge.md","hooks/session-bootstrap.md","hooks/session-start.sh","images/before-after.svg","images/brainstorm-session.svg","images/build-review-chain.svg","images/hero-banner-v2.svg","images/model-tiering.svg","scripts/tests/helpers.sh","scripts/tests/run.sh","s