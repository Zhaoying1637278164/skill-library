{"file":"liste-1.1.2-v2.zip","bytes":2356976,"status":"已读取","plugins":[{"path":".claude-plugin/plugin.json","name":"liste","description":"Claude Code skills for the liste CLI roadmap tracker. 19 skills covering the full liste interface for managing project roadmaps as markdown files.","version":"1.1.2","license":"MIT","repository":"https://github.com/dove-tools/liste","homepage":"https://github.com/dove-tools/liste","keywords":["roadmap","project-management","tracker","skills","cli","ai-agents"]}],"skills":[{"path":"skills/add-bug/SKILL.md","name":"liste-add-bug","description":"Add a bug to the liste roadmap. Use when a defect, error, crash, or unexpected behavior is discovered during development. Invoke as /liste-add-bug.","headings":["Add Bug to liste","Step 1: Search for duplicates","Step 2: Add the bug and capture the ID","Step 3: Set priority","Step 4: Link if related","One-shot via batch"],"name_hint":"liste · add · bug"},{"path":"skills/add-epic/SKILL.md","name":"liste-add-epic","description":"Add a large grouping of related work to the liste roadmap. Use for major initiatives containing multiple features, tasks, and bugs. Invoke as /liste-add-epic.","headings":["Add Epic to liste","Step 1: Search for duplicates","Step 2: Add the epic and capture the ID","Step 3: Assign phase and link children","One-shot via batch"],"name_hint":"liste · add · epic"},{"path":"skills/add-feature/SKILL.md","name":"liste-add-feature","description":"Add a new feature to the liste roadmap. Use for new capabilities that don't yet exist. Invoke as /liste-add-feature.","headings":["Add Feature to liste","Step 1: Search for duplicates","Step 2: Add the feature and capture the ID","Step 3: Set metadata","Step 4: Link dependencies","One-shot via batch"],"name_hint":"liste · add · feature"},{"path":"skills/add-idea/SKILL.md","name":"liste-add-idea","description":"Add an unplanned concept or future possibility to the liste roadmap. Use for things worth capturing but not yet committed to. Invoke as /liste-add-idea.","headings":["Add Idea to liste","Step 1: Search for duplicates","Step 2: Add the idea and capture the ID","Optional: Add context"],"name_hint":"liste · add · idea"},{"path":"skills/add-task/SKILL.md","name":"liste-add-task","description":"Add a concrete work unit to the liste roadmap. Use for specific, actionable items (write tests, update docs, refactor X). Invoke as /liste-add-task.","headings":["Add Task to liste","Step 1: Search for duplicates","Step 2: Add the task and capture the ID","Step 3: Set metadata","Step 4: Link to parent","One-shot via batch"],"name_hint":"liste · add · 任务"},{"path":"skills/append/SKILL.md","name":"liste-append","description":"Add notes, findings, or context to an existing liste item's body. Use when you learn something significant about an item during work. Invoke as /liste-append.","headings":["Append to a liste Item"],"name_hint":"liste · append"},{"path":"skills/batch/SKILL.md","name":"liste-batch","description":"Run multiple liste commands atomically via stdin. Use when making 3 or more mutations in a single operation. Invoke as /liste-batch.","headings":["Batch liste Mutations","From file"],"name_hint":"liste · batch"},{"path":"skills/block/SKILL.md","name":"liste-block","description":"Mark a liste item as blocked. Use when you cannot proceed due to an external dependency, decision, or missing resource. Invoke as /liste-block.","headings":["Block a liste Item"],"name_hint":"liste · block"},{"path":"skills/diff/SKILL.md","name":"liste-diff","description":"Show what has changed in the roadmap since the last check. Use at session start/end to see recent activity. Invoke as /liste-diff.","headings":["liste Changes Since Last Check","Since a specific date"],"name_hint":"liste · diff"},{"path":"skills/done/SKILL.md","name":"liste-done","description":"Mark a liste item as complete. Invoke as /liste-done or immediately when finishing work on a liste item.","headings":["Mark liste Item Done"],"name_hint":"liste · done"},{"path":"skills/find/SKILL.md","name":"liste-find","description":"Search for existing liste items before creating new ones. Always run before any add command to prevent duplicates. Invoke as /liste-find.","headings":["Find in liste","Quick check (IDs only)","Full search with metadata","Filtered browsing","View hierarchy"],"name_hint":"liste · 查找"},{"path":"skills/link/SKILL.md","name":"liste-link","description":"Create a typed relationship between two liste items. Use when you discover a dependency, hierarchy, or association. Invoke as /liste-link.","headings":["Link liste Items","Link types","Remove a link","View full link graph"],"name_hint":"liste · link"},{"path":"skills/next/SKILL.md","name":"liste-next","description":"Show the highest-priority items ready to work on next. Invoke as /liste-next.","headings":["What to Work on Next","Single highest-priority item","Multiple candidates","Items with all dependencies satisfied","Items currently in progress","Just the IDs"],"name_hint":"liste · next"},{"path":"skills/progress/SKILL.md","name":"liste-progress","description":"Show completion progress across the roadmap. Use to see done vs remaining. Invoke as /liste-progress.","headings":["liste Completion Progress","By phase","Items not updated recently"],"name_hint":"liste · progress"},{"path":"skills/promote/SKILL.md","name":"liste-promote","description":"Advance a liste item to its next status in the lifecycle. Default lifecycle: idea → planned → active → done. Invoke as /liste-promote.","headings":["Promote a liste Item"],"name_hint":"liste · promote"},{"path":"skills/session-start/SKILL.md","name":"liste-session-start","description":"Load liste project context and install hard behavioral rules at session start. Invoke at the start of every session when working in a project directory. Triggers when CLAUDE.md says \"invoke liste:session-start at session start\" or similar.","headings":["liste Session Start","Step 1: Detect project","Step 2: Hard behavioral rules","Before creating any item","Bug found","Starting work on an item","Completing an item","Blocked on an item","Dependency discovered","Significant finding about an item","Three or more mutations needed","Step 3: Show work queue"],"name_hint":"liste · session · start"},{"path":"skills/set/SKILL.md","name":"liste-set","description":"Update a field on an existing liste item. Use to change priority, phase, status, or tags. Invoke as /liste-set.","headings":["Set a Field on a liste Item","Common fields","Adding tags","View current values"],"name_hint":"liste · set"},{"path":"skills/start/SKILL.md","name":"liste-start","description":"Mark a liste item as active — you are beginning work on it now. Invoke as /liste-start or when beginning work on a planned item.","headings":["Start a liste Item"],"name_hint":"liste · start"},{"path":"skills/status/SKILL.md","name":"liste-status","description":"Show a full roadmap overview: phases, status counts, and blocked items. Use for a command-center view of current project state. Invoke as /liste-status.","headings":["liste Status Overview","Compact AI-agent summary (preferred)","Phase overview","Status counts","Blocked items"],"name_hint":"liste · status"}],"commands":[],"readmes":[{"path":"README.md","headings":["Install","Homebrew (macOS / Linux)","Claude Code plugin","Go install","Scoop (Windows)","Release binaries","Build from source","Quick Start","Initialize a roadmap in your project","Add items","View your roadmap","Work on items","Link items","See what's ready to work on","AI agent context (compact summary for LLM consumption)","Interactive TUI","Views","Keybindings","Concepts","Item Types","Statuses","Phases","Links","Multi-Project","Commands","Core","Status & Planning","Links & Structure","Views & Reporting","Editing"]}],"mcp_servers":[],"config_names":[],"paths":[".claude-plugin/marketplace.json",".claude-plugin/plugin.json",".github/workflows/ci.yaml",".github/workflows/release.yaml",".gitignore",".goreleaser.yaml",