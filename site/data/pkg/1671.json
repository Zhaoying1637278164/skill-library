{"file":"VillageSQL Skills-v2.zip","bytes":171685,"status":"已读取","plugins":[{"path":".claude-plugin/plugin.json","name":"villagesql","displayName":"VillageSQL Skills","description":"Skills for VillageSQL (MySQL with extensions): build extensions end-to-end (including porting PostgreSQL extensions to MySQL) and install VillageSQL Server."},{"path":".codex-plugin/plugin.json","name":"villagesql","description":"Skills for VillageSQL including building extensions from scratch and porting PostgreSQL extensions to VillageSQL.","version":"1.0.0","license":"Apache-2.0","repository":"https://github.com/villagesql/villagesql-skills","keywords":["villagesql","mysql","extensions","database","developer-tools"]},{"path":"plugin.json","name":"villagesql","description":"Skills for VillageSQL development — install and verify a server, and build VEF extensions end-to-end through a 7-phase workflow."}],"skills":[{"path":"skills/vsql-extension-builder/SKILL.md","name":"vsql-extension-builder","description":"Build a VillageSQL extension end-to-end using the 7-phase persona-driven workflow: requirements, feasibility, scaffold, implementation, CTO review, UAT, and documentation. Supports C++ (default) and Rust implementations. Discovers the current VEF API from live SDK sources during Phase 1 feasibility and Phase 2 bootstrap — no hardcoded API names. Works from any directory.","headings":["VillageSQL Extension Builder","Arguments","Fresh Start Rule","Identity & Mission","Context Management","Persona Overview","Workflow","Phase 0: Foundation & Environment *(Product Strategist)*","Phase 1: Discovery & Architecture *(Architect)*","Phase 2: Template & Scaffold *(Architect, continued)*","Phase 3: Incremental Implementation *(Team Lead)*","Phase 4: Quality Review *(CTO)*","Phase 5: User Acceptance Testing *(End-User)*","Phase 6: Documentation & Cleanup *(Product Strategist)*","Post-gate: Skill Retrospective *(after Summary is presented)*","Skill Retrospective — <extension-name>","Friction poin