"testing","automation","ai","agents","workflow","diagnosis","authoring","integration","plugin"]}],"skills":[{"path":"skills/bugbug-context-discovering/SKILL.md","name":"bugbug-context-discovering","description":"Discovers BugBug project, repository, and tested-application context. Always run this skill before any other BugBug skill, including test authoring, step authoring, selector authoring, test debugging, test refactoring, project reporting, or YAML work. Project list checks are exluded.","headings":["BugBug Context Discovering","Preflight","Inputs","Safety","Workflow","MCP-Only Clients","Output","Resources"],"name_hint":"bugbug · 上下文 · discovering","description_zh":"探索 BugBug 项目、仓库和被测应用上下文，作为测试、步骤、选择器、调试、重构、报告或YAML工作之前的基础；单独检查项目列表除外。"},{"path":"skills/bugbug-project-reporting/SKILL.md","name":"bugbug-project-reporting","description":"Creates read-only BugBug project health reports for PM and QA audiences using run-history aggregates and optional export-based inventory analysis. Use for project health, trends, release risk, flakiness, stale tests, or coverage reporting. Run bugbug-context-discovering first.","headings":["BugBug Project Reporting","Preflight","Inputs","Safety","Workflow","Output","PM report","QA report","Resources"],"name_hint":"bugbug · 项目 · 报告","description_zh":"依据BugBug运行历史聚合及可选导出清单，只读生成面向PM和QA的项目健康报告，分析趋势、发布风险、偶发失败、过期测试及覆盖；先探索上下文。"},{"path":"skills/bugbug-selectors-authoring/SKILL.md","name":"bugbug-selectors-authoring","description":"Authors, reviews, repairs, and optimizes BugBug element selectors. Use before creating or changing any DOM-targeted step, assertion, condition, visual region, drag target, upload target, or selector preset. Run bugbug-context-discovering first.","headings":["BugBug Selectors Authoring","Preflight","Inputs","Safety","Workflow","Author-Verify Loop","Selector Data Model","Preferred authoring strategy order","Hard Avoid Rules","XPath vs CSS","Good / Bad Examples","Output","Resources"],"name_hint":"bugbug · selectors · authoring","description_zh":"编写、评审、修复和优化BugBug元素选择器，用于任何定位DOM的步骤、断言、条件、视觉区域、拖动上传目标或预设变更前；先探索上下文。"},{"path":"skills/bugbug-steps-authoring/SKILL.md","name":"bugbug-steps-authoring","description":"Creates and updates BugBug test steps. Use when choosing step types, building step payloads, naming steps, setting assertions or visual checks, or materializing element-targeting steps. Run bugbug-context-discovering first.","headings":["BugBug Steps Authoring","Preflight","Inputs","Safety","Workflow","Output","Resources"],"name_hint":"bugbug · steps · authoring","description_zh":"创建与修改BugBug测试步骤，选择步骤类型、构建载荷、命名、设置断言和视觉检查及落实元素目标；先探索上下文。"},{"path":"skills/bugbug-test-run-debugging/SKILL.md","name":"bugbug-test-run-debugging","description":"Validates and debugs BugBug test runs. Use to inspect an existing or latest test run, classify failures, inspect logs, DOM snapshots, screenshots, focus on a failed step run, or find a supported fix.","headings":["BugBug Test Run Debugging","Preflight","Inputs","Safety","Workflow","Phase 1: Gather evidence","Phase 2: Compare against a passing run","Phase 3: Form one hypothesis","Phase 4: Repair and verify","After 2 failed repairs: question the step","Failure routing","Red flags","Output","Resources"],"name_hint":"bugbug · 测试 · run · debugging","description_zh":"验证与调试BugBug已有或最新测试运行，分类失败、读取日志DOM快照和截图，聚焦失败步骤并查找受支持的修复。"},{"path":"skills/bugbug-tests-authoring/SKILL.md","name":"bugbug-tests-authoring","description":"Creates and maintains BugBug tests with AI agents from an approved plan. Use for creating tests, editing steps, organizing reusable assets, optimizing reuse, or producing BugBug automation changes through CLI, SDK, or MCP surfaces. Defers to bugbug-tests-planning when tests still need to be designed or scoped.","headings":["BugBug Tests Authoring","Preflight","Inputs","Safety","Workflow","The Process","Process Flow","Capability routing","Output","Resources"],"name_hint":"bugbug · tests · authoring","description_zh":"依据已批准计划，通过CLI、SDK或MCP创建维护BugBug测试，编辑步骤、整理复用资产并优化复用；尚需设计或界定范围时先用测试规划技能。"},{"path":"skills/bugbug-tests-planning/SKILL.md","name":"bugbug-tests-planning","description":"Plans BugBug end-to-end and UI test coverage. Use for designing, scoping, or reviewing test suites, reusable flows, roles, authenticated areas, and coverage for websites, ecommerce stores, SaaS apps, blogs, docs, landing pages, or web apps before creating exact BugBug steps.","headings":["BugBug Tests Planning","Preflight","Inputs","Safety","Workflow","Process Flow","The Process","Progressive discovery","Output","Resources"],"name_hint":"bugbug · tests · 规划","description_zh":"规划BugBug端到端和UI测试覆盖，在创建具体步骤前设计或评审测试套件、复用流程、角色和认证区域，适用于网站、电商、SaaS、博客、文档及网页应用。"},{"path":"skills/bugbug-tests-refactoring/SKILL.md","name":"bugbug-tests-refactoring","description":"Analyzes and refactors BugBug tests, groups, components, suites, names, and duplication. Use read-only analysis mode unless the user explicitly requests mutations. Run bugbug-context-discovering first.","headings":["BugBug Tests Refactoring","Preflight","Inputs","Safety","Workflow","Output","Resources"],"name_hint":"bugbug · tests · refactoring","description_zh":"分析与重构BugBug测试、组、组件、套件、命名和重复内容；默认只读分析，用户明确要求时才修改，先探索上下文。"},{"path":"skills/bugbug-yaml-authoring/SKILL.md","name":"bugbug-yaml-authoring","description":"Creates, edits, reviews, validates, repairs, summarizes, and explains BugBug YAML files. Use for BugBug test, suite, project, component, profile, step action, action_details, schema, semantic, or safety-review YAML work.","headings":["BugBug YAML v1","Preflight","Inputs","Safety","Workflow","Capability routing","Root envelope","Output","Resources"],"name_hint":"bugbug · yaml · authoring","description_zh":"创建、编辑、评审、验证、修复、总结或解释BugBug YAML，涵盖测试、套件、项目、组件、配置档案、步骤动作、action_details、架构、语义和安全评审。"}],"commands":[],"readmes":[{"path":"README.md","headings":["BugBug Agent Plugin","Features","What you get","Bundled skills","When to use it"]}],"mcp_servers":["bugbug","bugbug"]