{"file":"Sent-0.1.0-v1.zip","bytes":189536,"status":"已读取","plugins":[{"path":".claude-plugin/plugin.json","name":"sent","description":"Official Sent business messaging plugin for SMS, WhatsApp, RCS, API integration, webhooks, routing, two-way messaging, Sender Profiles, migration, compliance, analytics, and agent-safe operations.","version":"0.1.0","license":"MIT","repository":"https://github.com/sentdm/sent-plugin","homepage":"https://github.com/sentdm/sent-plugin#readme","keywords":["sent","agent-skills","business-messaging","messaging","sms","whatsapp","rcs","10dlc","a2p","tcr","waba","rbm","contacts","templates","analytics","deliverability","sender-profiles","api-integration","webhooks","routing","two-way-messaging","migration","mcp"]}],"skills":[{"path":"skills/messaging-performance-analyzer/SKILL.md","name":"messaging-performance-analyzer","description":"Analyzes Sent message delivery, webhook, and activity data to explain funnel drop-offs, delivery failures, read-rate gaps, channel fallback, and suspicious performance changes. Use when a user says MDR, delivery report, message activity, webhook event, failed messages, low delivery rate, RCS fallback, WhatsApp read rate, SMS filtering, campaign performance, or asks why messages did not arrive.","headings":["Messaging performance analyzer","Overview","When to use","Evidence hierarchy","Process","1. Pin the question before slicing the funnel","2. Build cohorts from Sent message IDs","3. Normalize lifecycle stages to Sent’s documented statuses","4. Check webhook health before diagnosing delivery","5. Split by channel before naming a root cause","6. Quantify impact before recommending fixes","7. Convert the diagnosis into the next action","Common rationalizations to avoid","Verification checklist","Related skills","Bundled references and scripts"],"name_hint":"messaging · 性能/表现 · analyzer","description_zh":"分析 Sent投递、webhook及活动数据，解释漏斗流失、失败、阅读率差距、渠道回退和异常表现，涵盖 RCS、WhatsApp和 SMS。"},{"path":"skills/migrate-to-sent/SKILL.md","name":"migrate-to-sent","description":"Plans and executes a migration from Twilio, Sinch, Infobip, Vonage, or MessageBird/Bird to Sent v3 — mapping send calls, status vocabularies, webhook signature schemes, opt-out stores, templates, and tenancy models, then cutting over safely with dual-run and rollback. Use when replacing an incumbent CPaaS provider, translating provider code or webhook handlers to Sent, or planning a phased cutover and its verification gates.","headings":["Migrate to Sent","1. Ordered fallback becomes automatic routing","2. Status vocabularies do not line up","3. Webhook verification is a rewrite, not a port","4. Opt-out stores must be reconciled, not migrated by copy","5. Templates and tenancy are re-registered, not transferred","Migration sequence","Mistakes that survive testing","Boundaries"],"name_hint":"migrate · to · sent","description_zh":"规划执行从 Twilio、Sinch、Infobip、Vonage或 Bird迁移到 Sent v3，映射发送调用、状态、签名、退订、模板及租户模型，通过双跑、回滚和核验门禁安全切换。"},{"path":"skills/rcs-agent-onboarding/SKILL.md","name":"rcs-agent-onboarding","description":"Guides current Sent RCS and RBM onboarding, launch evidence, carrier approval, text and suggestion-chip templates, Sender Profile readiness, and safe routing. Use for RCS launch, fallback, pinned-channel tests, or broadcast prevention.","headings":["RCS Agent Onboarding","Current capability boundary","Routing semantics","Untrusted evidence boundary","Onboarding workflow","1. Define the launch use case","2. Verify Sender Profile readiness","3. Prepare the evidence packet","4. Hand off to Sent","5. Build current templates","6. Test deliberately","Launch acceptance"],"name_hint":"rcs · 智能体 · 入门/入职","description_zh":"指导 Sent RCS和 RBM入驻、上线证据、运营商审批、文本及建议按钮模板、Sender Profile准备和安全路由，支持回退、固定渠道测试及防止广播。"},{"path":"skills/sender-profile-architect/SKILL.md","name":"sender-profile-architect","description":"Designs Sent Sender Profile architecture for multi-tenant, multi-brand, and multi-channel systems. Use for API-key scoping, x-profile-id, isolation, inheritance, sharing, billing, WABA, 10DLC campaigns, webhooks, or tenant offboarding.","headings":["Sender Profile Architect","Recommended tenancy model","Authentication patterns","Profile creation model","Inheritance rules","Billing and number references","WABA choices","10DLC and campaigns","Completion and status handling","Webhook attribution","Design checklist"],"name_hint":"sender · profile · architect","description_zh":"设计 Sent多租户、多品牌、多渠道 Sender Profile，处理 API key范围、x-profile-id、隔离继承、共享计费、WABA、10DLC、webhook与租户退出。"},{"path":"skills/sent-account-readiness/SKILL.md","name":"sent-account-readiness","description":"Checks the authorized Sent account, organization and Sender Profile scope, balance, onboarding/KYC status, and readiness with the Sent MCP tools. Use when a user asks whether the account can send, what the MCP connection authorized, whether funds are sufficient, why onboarding is blocked, or for a preflight check before a mutation or channel launch. Route remediation to the relevant onboarding or compliance skill.","headings":["Sent Account Readiness","Authorize safely","Check readiness","Route remediation"],"name_hint":"sent · account · readiness"},{"path":"skills/sent-analytics/SKILL.md","name":"sent-analytics","description":"Queries Sent phone-number capabilities and aggregate messaging, deliverability, and contact analytics with the Sent MCP tools. Use when a user asks for number lookup, line or channel capability, messages sent, delivery rate, contact growth, dashboard metrics, period comparisons, or date-bounded trends. Use messaging-performance-analyzer for message-level evidence and root-cause diagnosis.","headings":["Sent Analytics","Establish context","Look up a number","Query dashboard metrics","Choose aggregate analytics or diagnosis"],"name_hint":"sent · analytics"},{"path":"skills/sent-contacts/SKILL.md","name":"sent-contacts","description":"Lists, finds, inspects, bulk-creates, summarizes, or deletes Sent contacts with the Sent MCP tools. Use when a user asks to search contacts, get a contact by ID, import or deduplicate a contact list, review a contact's messaging summary, remove a contact, or manage direct contact records. Requires confirmation gates for creates and deletes.","headings":["Sent Contacts","Establish connection and scope","Read contacts","Create contacts in bulk","Delete a contact","Report results"],"name_hint":"sent · contacts"},{"path":"skills/sent-integration-starter/SKILL.md","name":"sent-integration-starter","description":"Stands up a production-ready Sent v3 integration in an existing codebase — SDK selection and client construction, x-api-key configuration, idempotent sends, retry and rate-limit handling, the 46-code error catalog, sandbox verification, and a verified webhook receiver. Use when adding Sent to an app for the first time, choosing an SDK or framework wiring, handling 429 or 409 responses, deciding what to log, or hardening an integration before launch.","headings":["Sent Integration Starter","Stage 1: client and credentials","Stage 2: idempotent sends","Stage 3: verified webhook receiver","Stage 4: harden","Retry policy by response class","Error handling","Observability","Launch checklist","Verification","Boundaries"],"name_hint":"sent · 集成 · starter"},{"path":"skills/sent-messaging/SKILL.md","name":"sent-messaging","description":"Sends SMS, WhatsApp, or RCS messages through Sent and retrieves individual message status and activity history with the Sent MCP tools. Use when a user asks to send or preview a message, check a message ID, confirm delivery status, inspect lifecycle events, investigate a timed-out or ambiguous send, or retry safely. Use messaging-performance-analyzer for aggregate delivery diagnosis.","headings":["Sent Messaging","Establish connection and scope","Inspect a message","Prepare a send","Handle results and retries"],"name_hint":"sent · messaging"},{"path":"skills/sent-profile-provisioning/SKILL.md","name":"sent-profile-provisioning","description":"Executes the Sent Sender Profile lifecycle over the API — creating profiles with the right inheritance, sharing, billing, and WhatsApp options, driving profile completion and its callback, managing 10DLC campaigns per profile, and administering users and roles. Use when calling POST /v3/profiles, handling a completion callback or unclear profile status, choosing inherit or dedicated resources, wiring per-tenant onboarding, or inviting and role-managing users.","headings":["Sent Profile Provisioning","Provisioning sequence","Create payload essentials","Inheritance decisions","WhatsApp: exactly three paths","Completion and status","Campaigns per profile","Users and roles","Multi-tenant provisioning notes","Boundaries"],"name_hint":"sent · profile · provisioning"},{"path":"skills/sent-routing-strategist/SKILL.md","name":"sent-routing-strategist","description":"Decides how a Sent message should reach the recipient — automatic routing versus a pinned channel, what the channel array actually does, how fallback and reroute work, and why a message ended as FAILED, FILTERED, BLOCKED, or channel \"auto\". Use when choosing the channel field, expecting WhatsApp-to-SMS fallback, debugging an unexpected route or duplicate charges from multiple channels, or interpreting message status and activity evidence.","headings":["Sent Routing Strategist","Decide the channel value","What a pinned channel gives up","Reading the outcome","Terminal status interpretation","Reroute behavior","How automatic routing selects a route","Cost and volume consequences","Boundaries"],"name_hint":"sent · routing · strategist"},{"path":"skills/sent-templates/SKILL.md","name":"sent-templates","description":"Lists, finds by name or ID, inspects, or deletes existing Sent templates with the Sent MCP tools. Use when a user asks to browse templates, find an approved template, check template language, channel, category, or status, retrieve a template record, or delete a template. Use waba-template-author to write WhatsApp content and template-builder-ui to design template interfaces.","headings":["Sent Templates","Establish connection and scope","Find and inspect templates","Delete a template"],"name_hint":"sent · templates"},{"path":"skills/sent-two-way-messaging/SKILL.md","name":"sent-two-way-messaging","description":"Designs inbound and conversational Sent flows — opt-out and opt-in keyword handling, consent state on contacts, auto-replies inside the WhatsApp 24-hour window, RCS STOP chips, conversation history retrieval, and per-channel inbound capability. Use when handling message.received events, implementing STOP or HELP behavior, restoring consent after an opt-out, building a support inbox or chatbot on Sent, or paginating conversation history.","headings":["Sent Two-Way Messaging","Keyword handling","Consent state","Per-channel inbound reality","RCS STOP chips","The WhatsApp 24-hour window","Conversation history","Building a support inbox or bot","Boundaries"],"name_hint":"sent · two · way · messaging"},{"path":"skills/sent-webhook-engineer/SKILL.md","name":"sent-webhook-engineer","description":"Builds and debugs Sent v3 webhook receivers end to end — endpoint registration, HMAC signature verification, replay rejection, event dedupe, retry and auto-disable behavior, secret rotation, and delivery-log triage. Use when handling Sent webhook events, verifying x-webhook-signature, fixing 401 or signature-mismatch failures, recovering a disabled endpoint, choosing event_types or event_filters, rotating a signing secret, or interpreting the webhook delivery log.","headings":["Sent Webhook Engineer","Signature verification, exactly","Failure triage order","Retry, auto-disable, and recovery","Registration and configuration","Secret rotation","Event payloads","Verification before shipping","Local development","Boundaries"],"name_hint":"sent · webhook · engineer"},{"path":"skills/sent/SKILL.md","name":"sent","description":"Routes broad or ambiguous Sent requests to the correct MCP-backed operation or specialist skill. Use when the user asks what Sent can do, says \"help me with Sent\" or \"set up messaging,\" needs several Sent workflows, or has not made the channel, task, or desired operation clear enough to select a more specific skill.","headings":["Sent Meta Dispatcher","Overview","When to Use","Routing rules","MCP-backed operations","Specialist guidance","Engineering and integration","Clarifying questions to ask before routing","When to handle without routing","Shared terminology"],"name_hint":"sent"},{"path":"skills/sms-10dlc-registration/SKILL.md","name":"sms-10dlc-registration","description":"Prepares and validates Sent US A2P 10DLC brand and campaign registration through Sender Profiles, including inheritance, all campaign use cases, opt-in evidence, sample-message policy, autoresponses, sandbox validation, TCR status, and rejection remediation.","headings":["SMS 10DLC Registration","Current Sent resource model","Choose inheritance deliberately","Two validation layers","Evidence readiness packet","Sent campaign request","API use cases","Volume and status","Safe workflow"],"name_hint":"sms · 10dlc · registration"},{"path":"skills/template-builder-ui/SKILL.md","name":"template-builder-ui","description":"Designs and audits tenant-facing Sent template builders, previews, validation, lifecycle UX, and API payload mapping. Use for template editor forms, variables, channel overrides, WhatsApp review, RCS suggestion chips, authentication templates, and safe submission flows.","headings":["Sent Template Builder UI","Product model","Recommended editor sequence","Variable UX","Validation matrix","Channel previews","SMS","WhatsApp","RCS","Save and review behavior","Lifecycle UX","Accessibility and failure recovery"],"name_hint":"template · builder · ui"},{"path":"skills/waba-embedded-signup/SKILL.md","name":"waba-embedded-signup","description":"Guides WhatsApp Business Account onboarding through Sent, separating dashboard Embedded Signup, organization WABA inheritance, and direct child-profile credentials. Use for WABA connection, Meta signup, profile creation, access-token handling, phone number mapping, completion callbacks, or WhatsApp onboarding failures.","headings":["WABA Onboarding and Embedded Signup","The three paths","Authentication","Path A: organization Embedded Signup","Path B: inherit the organization WABA","Path C: dedicated WABA credentials","Complete the profile","Verify operational readiness","Failure routing"],"name_hint":"waba · embedded · signup"},{"path":"skills/waba-template-author/SKILL.md","name":"waba-template-author","description":"Writes, classifies, validates, and repairs WhatsApp templates using the Sent v3 template definition contract. Use for utility, marketing, authentication, OTP, Meta review, rejected templates, variables, buttons, channel overrides, or submission-ready Sent payloads.","headings":["WhatsApp Template Author","Source precedence","Authoring workflow","1. Establish intent and category","2. Build the Sent create request","3. Define variables exactly","4. Add supported buttons","5. Handle authentication templates","6. Validate before submission","7. Track the right lifecycle surface","Boundaries"],"name_hint":"waba · template · author"}],"commands":[{"path":".claude/commands/mdr-analyze.md","name":"mdr-analyze","description":"Analyze Sent message-delivery performance","headings":[]},{"path":".claude/commands/rcs-onboard.md","name":"rcs-onboard","description":"Prepare an RCS launch through Sent","headings":[]},{"path":".claude/commands/sender-plan.md","name":"sender-plan","description":"Design Sent Sender Profile architecture","headings":[]},{"path":".claude/commands/sent.md","name":"sent","description":"Route a request through the Sent skill set","headings":[]},{"path":".claude/commands/sms-register.md","name":"sms-register","description":"Prepare a Sent US 10DLC registration","headings":[]},{"path":".claude/commands/temp