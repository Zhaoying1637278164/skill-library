{"file":"CSitRep Generator-3.0.0-v2.zip","bytes":123467,"status":"已读取","plugins":[{"path":".claude-plugin/plugin.json","name":"csitrep-generator","description":"Multi-agent Situation Report (SitRep) generator for any project type. Supports construction, software, development programs, product/manufacturing, consulting, and custom projects. Dispatches specialist agents to analyze documents and synthesizes findings into actionable reports.","version":"3.0.0","license":"MIT","repository":"https://github.com/chiKeka/csitrep-generator","homepage":"https://github.com/chiKeka/csitrep-generator","keywords":["project-management","reporting","sitrep","multi-agent","construction","software","consulting"]}],"skills":[{"path":"skills/compare/SKILL.md","name":"compare","description":"Compare current SitRep against previous reports to identify trends. Use when the user asks about trends, progress over time, or wants to compare reports.","headings":["SitRep Trend Analysis","Step 1: Find Available Reports","Step 2: Select Reports to Compare","Step 3: Analyze Trends","Step 4: Present Trend Report","Rules"],"name_hint":"compare"},{"path":"skills/dashboard-ui/SKILL.md","name":"dashboard-ui","description":"Generate a visual HTML dashboard from the latest SitRep. Use when the user wants a visual report, HTML dashboard, PDF report, or browser-viewable status.","headings":["Visual Dashboard Generator","Step 1: Find the Report","Step 2: Parse the Report","Step 3: Generate HTML Dashboard","Step 4: Fill the Template","Step 5: Open in Browser","Step 6: Offer PDF Export","Rules"],"name_hint":"看板 · ui"},{"path":"skills/dashboard/SKILL.md","name":"dashboard","description":"Quick one-line status per domain. Use when the user asks for a quick status, dashboard, summary, or health check without a full report.","headings":["Quick Dashboard","Step 1: Load Config","Step 2: Check for Latest SitRep","If a recent report exists:","If no report exists:","Rules"],"name_hint":"看板"},{"path":"skills/feedback/SK