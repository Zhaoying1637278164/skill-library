{"file":"Alexandria-1.0.0-v1.zip","bytes":1798294,"status":"已读取","plugins":[{"path":".claude-plugin/plugin.json","name":"alexandria","description":"Teaches you your own codebase like a patient instructor, then archives every lesson into a personal Obsidian library -- per-project glossaries, cross-project concept indexes, and drift detection that flags stale explanations. Invoke-only: it never triggers on ordinary coding requests.","version":"1.0.0","license":"MIT","repository":"https://github.com/paynekerz/alexandria","homepage":"https://github.com/paynekerz/alexandria","keywords":["learning","teaching","codebase-onboarding","obsidian","knowledge-base","documentation"]}],"skills":[{"path":"evals/tooling/SKILL.md","name":"skill-creator","description":"Create new skills, modify and improve existing skills, and measure skill performance. Use when users want to create a skill from scratch, edit, or optimize an existing skill, run evals to test a skill, benchmark skill performance with variance analysis, or optimize a skill's description for better triggering accuracy.","headings":["Skill Creator","Communicating with the user","Creating a skill","Capture Intent","Interview and Research","Write the SKILL.md","Skill Writing Guide","Report structure","[Title]","Executive summary","Key findings","Recommendations","Commit message format","Writing Style","Test Cases","Running and evaluating test cases","Step 1: Spawn all runs (with-skill AND baseline) in the same turn","Step 2: While runs are in progress, draft assertions"],"name_hint":"技能 · creator","description_zh":"创建、修改和优化 skill，运行评测及含方差分析的性能对标，并改进 description 的触发准确性。"},{"path":"skills/alexandria-librarian/SKILL.md","name":"alexandria-librarian","description":"Persistence layer of the Alexandria learning suite. Use ONLY when the user explicitly asks Alexandria to save, file, or archive a lesson (e.g. \"alexandria, save this lesson\" or accepting alexandria-teach's save offer). Never use for general note-taking or file-writing requests that don't name Alexandria.","headings":["alexandria-librarian","Step 0 -- Config check (every invocation, before anything else)","First-run interview (exit code 1 only)","Step 1 -- Confirm the concept list (always, before any write)","Step 2 -- Assemble the save payload","Step 3 -- Save through the script"],"name_hint":"alexandria · librarian"},{"path":"skills/alexandria-recall/SKILL.md","name":"alexandria-recall","description":"Memory layer of the Alexandria learning suite. Use ONLY when the user explicitly asks Alexandria what it has already taught them or whether a lesson is stale (e.g. \"alexandria, have we covered this before?\"). Never use for general search, documentation lookup, or memory requests that don't name Alexandria.","headings":["alexandria-recall","Step 0 -- Config check (every invocation, before anything else)","First-run interview (exit code 1 only)","Step 1 -- Scope the lookup","Step 2 -- Run the retrieval script","Step 3 -- Answer from the results","Step 4 -- Cross-project references (restricted -- two doors, both narrow)","Step 5 -- Drift check (whenever sessions are surfaced)"],"name_hint":"alexandria · recall"},{"path":"skills/alexandria-teach/SKILL.md","name":"alexandria-teach","description":"Explanation engine of the Alexandria learning suite. Use ONLY when the user explicitly invokes Alexandria by name or with /alexandria-teach to have code taught to them as a lesson (e.g. \"alexandria, teach me this file\"). Never use for ordinary coding, debugging, or code-review requests that don't name Alexandria.","headings":["alexandria-teach","Step 0 -- Config check (every invocation, before anything else)","First-run interview (exit code 1 only)","Step 1 -- Scope the lesson","Step 2 -- Library check (before explaining anything)","Step 3 -- Delegate the explanation","Step 4 -- Assemble the response","Step 5 -- End every response (mandatory, no exceptions)","Step 6 -- Comprehension check (conditional, session end)","Accuracy rules (Axiom 3 -- non-negotiable, override everything else)","Reference files (load on demand only -- token efficiency)"],"name_hint":"alexandria · teach"}],"commands":[],"readmes":[{"path":"README.md","headings":["Alexandria","The three skills","Requirements","Install","Option A -- as a plugin (recommended)","Option B -- manual copy","First-run setup","Daily use","Choosing a model","The vault","Troubleshooting","What Alexandria reads, writes, and fetches","Project documents","License"]},{"path":"skills/alexandria-teach/README.md","headings":["alexandria-teach"]},{"path":"skills/alexandria-recall/README.md","headings":["alexandria-recall"]},{"path":"skills/alexandria-librarian/README.md","headings":["alexandria-librarian"]}],"mcp_servers":[],"config_names":[],"paths":[".claude-plugin/marketplace.json",".claude-plugin/plugin.json",".github/workflows/markdown-lint.yml",".gitignore",".markdownlint-cli2.jsonc",".markdownlint.jsonc","CHANGELOG.md","LICENSE","README.md","agents/.gitkeep","agents/alexandria-teacher.md","docs/.gitkeep","docs/CONFIG.md","docs/DECISIONS.md","docs/DEMO-SCRIPT.md","docs/MARKETPLACE-COMPLIANCE.md","docs/MODEL-SELECTION.md","docs/RELEASE-CHECKLIST.md","docs/VAULT-SCHEMA.md","docs/WORKFLOW.md","docs/example-vault/.alexandria/meta.json","docs/example-vault/Alexandria/Sessions/2026-07-09 session-save-pipeline.md","docs/example-vault/Alexandria/Sessions/2026-07-09 vault-write-safety.md","docs/example-vault/Alexandria/_glossary.md","docs/example-vault/Alexandria/_index.md","docs/example-vault/Atlas/Sessions/2026-06-25 retry-idempotency.md","docs/example-vault/Atlas/Sessions/2026-07-01 request-pipeline.md","docs/example-vault/Atlas/_glossary.md","docs/example-vault/Atlas/_index.md","docs/example-vault/Aurora/Sessions/2026-06-12 checkout-tokenization-flow.md","docs/example-vault/Aurora/Sessions/2026-06-19 webhook-handling.md","docs/example-vault/Aurora/_glossary.md","docs/example-vault/Aurora/_index.md","docs/example-vault/Welcome.md","docs/example-vault/_Concept