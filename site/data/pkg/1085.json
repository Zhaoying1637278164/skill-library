{"file":"OpenSearch Agent Skills-v2.zip","bytes":3625312,"status":"已读取","plugins":[{"path":".claude-plugin/plugin.json","name":"opensearch-agent-skills","displayName":"OpenSearch Agent Skills","description":"OpenSearch skills to help set up and deploy OpenSearch for a variety of use cases: build search applications with semantic, hybrid, neural sparse, and agentic search strategies; analyze observability data with log analytics (PPL and Query DSL) and distributed traces (OpenTelemetry); deploy to Amazon OpenSearch Service or OpenSearch Serverless with Bedrock integration for embeddings and RAG, or to Aiven for OpenSearch (managed, multi-cloud). Just ask your AI assistant to set up a search app, query logs, investigate traces, or deploy to AWS or Aiven.","license":"Apache-2.0","repository":"https://github.com/opensearch-project/opensearch-agent-skills","homepage":"https://github.com/opensearch-project/opensearch-agent-skills","keywords":["search","observability","opensearch","aws","aiven"]},{"path":".cursor-plugin/plugin.json","name":"opensearch-agent-skills","displayName":"OpenSearch Agent Skills","description":"OpenSearch skills to help set up and deploy OpenSearch for a variety of use cases: build search applications with semantic, hybrid, neural sparse, and agentic search strategies; analyze observability data with log analytics (PPL and Query DSL) and distributed traces (OpenTelemetry); deploy to Amazon OpenSearch Service or OpenSearch Serverless with Bedrock integration for embeddings and RAG, or to Aiven for OpenSearch (managed, multi-cloud). Just ask your AI assistant to set up a search app, query logs, investigate traces, or deploy to AWS or Aiven.","version":"0.4.0","license":"Apache-2.0","repository":"https://github.com/opensearch-project/opensearch-agent-skills","keywords":["search","observability","opensearch","aws","aiven"]}],"skills":[{"path":"skills/opensearch-skills/SKILL.md","name":"opensearch-skills","description":"Build search applications and query log analytics data with OpenSearch. Use this skill when the user mentions OpenSearch, search app, index setup, search architecture, semantic search, vector search, hybrid search, BM25, dense vector, sparse vector, agentic search, RAG, embeddings, KNN, PDF ingestion, document processing, or any related search topic. Also use for log analytics and observability — when the user wants to set up log ingestion, query logs with PPL, analyze error patterns, set up index lifecycle policies, investigate traces, or check stack health. Activate even if the user says log analysis, Fluent Bit, Fluentd, Logstash, syslog, traceId, OpenTelemetry, or log analytics without mentioning OpenSearch.","headings":["OpenSearch Skills","Routing","Feedback Collection (Required Behavior)","Rules","Triggers","How to Submit","Feedback Types","Shared Resources","Optional MCP Servers","Auto-Installing Missing MCP Servers","Answering OpenSearch Knowledge Questions"],"name_hint":"opensearch · 技能"},{"path":"skills/opensearch-skills/cloud/SKILL.md","name":"cloud","description":"Deploy OpenSearch search applications to managed cloud providers. Use this skill when the user wants to provision an OpenSearch domain or serverless collection on AWS, provision a managed OpenSearch service on Aiven, deploy search configurations, set up Bedrock connectors, configure IAM roles for OpenSearch, or migrate a local setup to a managed OpenSearch. Activate even if the user says AOS, AOSS, OpenSearch Service, serverless collection, Bedrock connector, SigV4, AWS deployment, Aiven, or managed OpenSearch.","headings":["Cloud","Skills","When to Use","Usage Attribution"],"name_hint":"cloud"},{"path":"skills/opensearch-skills/cloud/aiven-setup/SKILL.md","name":"aiven-setup","description":"Deploy OpenSearch search applications to Aiven for OpenSearch (a fully managed OpenSearch service across AWS, GCP, Azure, DigitalOcean, and UpCloud). Use this skill when the user wants to provision an Aiven OpenSearch service, deploy a search configuration to Aiven, migrate a local search setup to Aiven, or manage Aiven-hosted OpenSearch infrastructure. Activate even if the user says Aiven, avn, Aiven Console, managed OpenSearch on Aiven, or Aiven OpenSearch without mentioning search. For Amazon OpenSearch Service or Serverless, use aws-setup instead.","headings":["Aiven for OpenSearch Deployment","Prerequisites","Required MCP Servers","Key Rules","Workflow","Step 1 — Provision the Aiven OpenSearch service","Step 2 — Deploy the search configuration","Step 3 — Launch the Search UI","Step 4 — Verify health via Aiven (optional but recommended)","Step 5 — Provide access information","Reference"],"name_hint":"aiven · 设置"},{"path":"skills/opensearch-skills/cloud/aws-setup/SKILL.md","name":"aws-setup","description":"Deploy OpenSearch search applications to Amazon OpenSearch Service or Amazon OpenSearch Serverless. Use this skill when the user wants to provision an OpenSearch domain or serverless collection on AWS, deploy search configurations to AWS, set up Bedrock connectors, configure IAM roles for OpenSearch, migrate a local search setup to AWS, or manage Amazon OpenSearch infrastructure. Activate even if the user says AOS, AOSS, OpenSearch Service, serverless collection, Bedrock connector, SigV4, or AWS deployment without mentioning search.","headings":["OpenSearch AWS Deployment","Prerequisites","Required MCP Servers","opensearch-mcp-server Configuration for AWS","Critical Rules (MUST follow)","Key Rules","Deployment Target Selection","Workflow","Step 1 — Provision Infrastructure","Step 2 — Deploy Search Configuration","Step 3 — Configure Agentic Search (if applicable)","Step 4 — Launch Search UI","Step 5 — Provide Access Information","Reference"],"name_hint":"aws · 设置"},{"path":"skills/opensearch-skills/cloud/aws-setup/aoss/aoss-nextgen-provisioning/SKILL.md","name":"aoss-nextgen-provisioning","description":"Use when provisioning or deprovisioning OpenSearch Serverless collections, creating collection groups, setting up AOSS NextGen, or tearing down AOSS resources","headings":["OpenSearch Serverless NextGen Provisioning & Deprovisioning","Overview","When to Use","Critical Rules (MUST follow — violations are errors)","Key Constraints","Quick Reference","Naming Convention (Auto-Generated)","Companion Files","Entry Point","Step 1: Credential Check","Step 2: Mode Selection","Flow 1: Simple Provisioning","Inputs","Execution","Success Output","Flow 3: Standalone Collection (Classic)","Inputs","Execution"],"name_hint":"aoss · nextgen · provisioning"},{"path":"skills/opensearch-skills/cloud/managed-ingestion-service/SKILL.md","name":"managed-ingestion-service","description":"Ingest documents at scale into Amazon OpenSearch using OpenSearch Ingestion Service (OSIS) pipelines. Upload pre-generated JSONL chunks to S3 and OSIS indexes them — optionally using semantic_enrichment in the sink to create the index with ASE automatically. Cloud ingestion — uploading raw PDF/DOCX and letting document_extractor parse them in the cloud — is available via private beta. Use this skill when the user wants to ingest documents into a cloud OpenSearch domain or collection, process documents at full volume beyond local limits, or set up an OSIS pipeline. Activate even if the user says OSIS, ingestion pipeline, document extraction, S3 ingestion, managed ingestion, or cloud processing.","headings":["Managed Ingestion Service","Overview","When to Use","Ingestion Paths","Key Constraints","Entry Point","Step 1: Validate credentials","Step 2: Determine the deploy target","Step 3: Determine the data source","Step 4: Gather parameters","Step 5: Determine the sink mode","Step 6: Upload to S3","Step 7: Create OSIS pipeline","Step 8: Verify","Pipeline YAML — Local Chunking + New Index (AOSS with semantic_enrichment)","Pipeline YAML — Local Chunking + New Index (AOS domain with semantic_enrichment)","Pipeline YAML — Existing Index (no semantic_enrichment)","Cloud Ingestion (private beta)"],"name_hint":"managed · ingestion · service"},{"path":"skills/opensearch-skills/ingest/SKILL.md","name":"ingest","description":"Process unstructured documents into search-ready chunks. Use this skill when the user wants to process PDFs or unstructured documents into JSONL chunks using Docling. Activate even if the user says document processing, chunking, Docling, PDF processing, or chunk quality evaluation. For cloud-scale ingestion via OSIS pipelines, see cloud/managed-ingestion-service.","headings":["Ingest","Skills","Not Covered","When to Use"],"name_hint":"ingest"},{"path":"skills/opensearch-skills/ingest/document-processing/SKILL.md","name":"document-processing","description":"Process unstructured documents (PDF, DOCX, PPTX, XLSX) into search-ready JSONL chunks using Docling. Runs locally — no AWS or cloud services needed. Use this skill when the user wants to prepare documents for indexing, chunk documents, evaluate chunk quality, or convert PDFs to searchable text. Activate even if the user says process documents, chunk my files, prepare for search, or Docling.","headings":["Document Processing","Prerequisites","When to Use","Output","Reference"],"name_hint":"文档 · processing"},{"path":"skills/opensearch-skills/observability/SKILL.md","name":"observability","description":"Analyze logs and investigate traces in OpenSearch. Use this skill when the user wants to query logs with PPL, analyze error patterns, discover log patterns, investigate traces, check stack health, or perform any observability task. Activate even if the user says log analysis, Fluent Bit, Fluentd, Logstash, syslog, traceId, OpenTelemetry, PPL, span, latency, error rate, anomaly detection, or log analytics without mentioning OpenSearch.","headings":["Observability","Skills","When to Use"],"name_hint":"observability"},{"path":"skills/opensearch-skills/observability/log-analytics/SKILL.md","name":"log-analytics","description":"Analyze logs in OpenSearch using PPL and Query DSL. Use this skill when the user wants to query logs, analyze error patterns, discover log patterns, check error rates, perform anomaly detection on logs, or investigate application issues through log data. Activate even if the user says log analysis, Fluent Bit, Fluentd, Logstash, syslog, PPL, error rate, anomaly detection, log patterns, or log analytics without mentioning OpenSearch.","headings":["OpenSearch Log Analytics","Prerequisites","Optional MCP Servers","opensearch-mcp-server Configuration Variants","Critical Rules (MUST follow)","Key Rules","Workflow","Phase 1 — Connect to Cluster","Phase 2 — Discover Indices","Phase 3 — Understand Schema","Phase 4 — Analyze","Phase 5 — Advanced Analysis","Reference Files"],"name_hint":"日志 · analytics"},{"path":"skills/opensearch-skills/observability/trace-analytics/SKILL.md","name":"trace-analytics","description":"Investigate distributed traces and spans in OpenSearch. Use this skill when the user wants to analyze traces, investigate slow spans, find error spans, track agent invocations, measure token usage, reconstruct trace trees, query service maps, or debug distributed systems through trace data. Activate even if the user says traceId, spanId, OpenTelemetry, OTel, distributed tracing, latency, span duration, service map, or trace investigation without mentioning OpenSearch.","headings":["OpenSearch Trace Analytics","Prerequisites","Optional MCP Servers","opensearch-mcp-server Configuration Variants","Critical Rules (MUST follow)","Key Rules","Workflow","Phase 1 — Connect and Discover","Phase 2 — Investigate","Phase 3 — Deep Analysis","GenAI Operation Types","Reference Files"],"name_hint":"追踪 · analytics"},{"path":"skills/opensearch-skills/search/SKILL.md","name":"search","description":"Build search applications with OpenSearch. Use this skill when the user mentions search app, index setup, search architecture, semantic search, vector search, hybrid search, BM25, dense vector, sparse vector, agentic search, RAG, embeddings, KNN, PDF ingestion, document processing, search quality evaluation, or any related search topic.","headings":["Search","Skills","When to Use"],"name_hint":"搜索"},{"path":"skills/opensearch-skills/search/opensearch-launchpad/SKILL.md","name":"opensearch-launchpad","description":"Build search applications with OpenSearch from scratch. Use this skill when the user mentions search app, index setup, search architecture, semantic search, vector search, hybrid search, BM25, dense vector, sparse vector, agentic search, RAG, embeddings, KNN, PDF ingestion, document processing, or any related search topic. Activate even if the user says search quality, evaluation, nDCG, precision, relevance tuning, or search builder without mentioning OpenSearch.","headings":["OpenSearch Launchpad","Prerequisites","Optional MCP Servers","opensearch-mcp-server Configuration Variants","Scripts","Critical Rules (MUST follow)","Key Rules","Workflow Phases","Phase 0 — Preflight Check (ALWAYS first)","Phase 1 — Collect Sample Data","Phase 2 — Gather Preferences","Phase 3 — Plan","Phase 4 — Execute","Phase 5 — Evaluate (Optional)","Phase 6 — Deploy to AWS (Optional, target: `local` only)"],"name_hint":"opensearch · launchpad"}],"commands":[],"readmes":[{"path":"README.md","headings":["OpenSearch Agent Skills","Available Skills","Install","Install all skills","Install a specific skill","Install options","Install to a specific agent","Install globally (available across all projects)","Install to all detected agents","List available skills before installing","Claude Community Marketplace (Claude Code)","Add the community marketplace (one-time setup)","Install the plugin","Reload to apply","Prerequisites","Repo Structure","Contributing","License"]}],"mcp_servers":["opensearch-mcp-server","ddg-search","awslabs.aws-api-mcp-server","aws-knowledge-mcp-server","aiven-mcp"],"config_names":[],"paths":[".claude-plugin/plugin.json",".cursor-plugin/plugin.json",".github/CODEOWNERS",".github/workflows/add-untriaged.yml",".github/workflows/c