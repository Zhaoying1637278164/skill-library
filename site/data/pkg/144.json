{"file":"Arxitect-1.1.1-v2.zip","bytes":321001,"status":"已读取","plugins":[{"path":".claude-plugin/plugin.json","name":"arxitect","description":"Enforces best-practice software design & architecture","version":"1.1.1","license":"MIT","repository":"https://github.com/andonimichael/arxitect","homepage":"https://github.com/andonimichael/arxitect","keywords":["software-design","software-architecture","best-practice","solid","solid-principles","design-patterns","object-oriented-design","clean-architecture","api-design"]},{"path":".cursor-plugin/plugin.json","name":"arxitect","displayName":"Arxitect","description":"Enforces best-practice software design & architecture","version":"1.1.1","license":"MIT","repository":"https://github.com/andonimichael/arxitect","homepage":"https://github.com/andonimichael/arxitect","keywords":["software-design","software-architecture","best-practice","solid","solid-principles","design-patterns","object-oriented-design","clean-architecture","api-design"]}],"skills":[{"path":"skills/api-design-review/SKILL.md","name":"api-design-review","description":"Reviews code for API design quality including naming conventions, self-documenting interfaces, method signatures, parameter design, type safety, and REST endpoint design. Use when evaluating the usability and readability of public interfaces, class APIs, or REST endpoints.","headings":["API Design Review","Review Process","Finding ID Convention","Severity Guidelines","Pragmatism"],"name_hint":"api · 设计 · 评审","description_zh":"审阅公共接口、类 API 或 REST 端点的设计质量，包括命名、自说明接口、方法签名、参数、类型安全及可用性可读性。"},{"path":"skills/architect/SKILL.md","name":"architect","description":"Orchestrates an architecture-enforced implementation feedback loop. Implements code, then runs Object Oriented Design, Clean Architecture, and API Design reviews, iterating until all reviewers approve or the safety valve triggers. Use when implementing code that should meet design quality standards.","headings":["Architect","Process","Step 1: Prepare Context","Step 2: Implement","Step 3: Architecture Review","Step 4: Evaluate","Review Feedback — Iteration [N]","Object Oriented Design Findings","Clean Architecture Findings","API Design Findings","Previously Addressed","Iteration History","Step 5: Safety Valve","Step 6: Complete","Rules","Integration"],"name_hint":"architect","description_zh":"编排架构约束的实现反馈循环：写代码后进行面向对象、整洁架构及 API 设计审阅，迭代至全部批准或触发安全停止条件。"},{"path":"skills/architecture-review/SKILL.md","name":"architecture-review","description":"Runs all three architecture reviewers (Object Oriented Design, Clean Architecture, and API Design Reviewers).","headings":["Architecture Review","Process","Step 1: Identify Files to Review","Step 2: Dispatch Reviewers","Step 3: Present Combined Report","Architecture Review Results","Overall Verdict: [APPROVED | CHANGES_REQUESTED]","Object Oriented Design — [VERDICT]","Clean Architecture — [VERDICT]","API Design — [VERDICT]","Priority Actions","Rules","Integration"],"name_hint":"architecture · 评审","description_zh":"同时运行面向对象设计、整洁架构和 API 设计三类架构审阅。"},{"path":"skills/clean-architecture-review/SKILL.md","name":"clean-architecture-review","description":"Reviews code for clean architecture compliance including component cohesion principles (REP, CRP, CCP), component coupling principles (ADP, SDP, SAP), and quality attributes (maintainability, extensibility, testability). Use when evaluating architectural soundness of new or modified code.","headings":["Clean Architecture Review","Review Process","Severity Guidelines","Pragmatism"],"name_hint":"clean · architecture · 评审","description_zh":"检查新增或修改代码的整洁架构，包括组件内聚 REP/CRP/CCP、耦合 ADP/SDP/SAP 及可维护、扩展和测试性。"},{"path":"skills/oo-design-review/SKILL.md","name":"oo-design-review","description":"Reviews code for object-oriented design quality including SOLID principles, DRY violations, composition and inheritance choices, and Gang of Four design pattern applicability. Use when evaluating object oriented design of new or modified code.","heading