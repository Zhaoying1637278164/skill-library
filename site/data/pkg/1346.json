{"file":"SearchAtlas Toolkit-2.2.8-v1.zip","bytes":1125868,"status":"已读取","plugins":[{"path":".claude-plugin/plugin.json","name":"searchatlas","displayName":"SearchAtlas Toolkit","description":"Official SearchAtlas command-line toolkit — SEO, GBP, PPC, content, and AI visibility workflows powered by the SearchAtlas MCP.","version":"2.2.8","license":"MIT","homepage":"https://github.com/search-atlas-group/amm-toolkit","keywords":["seo","gbp","ppc","content","ai-visibility","llm-visibility","marketing","searchatlas"]}],"skills":[{"path":"skills/using-searchatlas/SKILL.md","name":"using-searchatlas","description":"Foundational routing rules, golden rules, and parameter reference for the SearchAtlas toolkit. Use whenever the user works on SEO, Google Business Profile (GBP), PPC / Google Ads, content generation, AI/LLM visibility, backlinks, brand vaults, OTTO projects, or any SearchAtlas task — to route the request to the right /searchatlas:* command and apply correct MCP usage patterns (schema discovery, async polling, never hardcoding IDs).","headings":["Using the SearchAtlas Toolkit","1. What This Plugin Is","2. MCP Server","3. Golden Rules","4. Parameter Quick Reference","5. Account Discovery Flow","6. Intent Routing — Match Request to Command","7. Workflow Execution Pattern","8. Communication Integrations","9. Conventions"],"name_hint":"using · searchatlas"}],"commands":[{"path":"commands/build-website.md","name":"build-website","description":"Generate a brand new marketing website from brand vault data via SearchAtlas Website Studio — guided end-to-end from brand intake through market research, design selection, content generation, and live publish.","headings":["/searchatlas:build-website","Data flow — Brand Vault is the single source of truth","Prerequisites","Phase 0 — Identify Target","Phase 0.5 — Quick Existence Check (BV + GBP only)","Phase 1.0 — Multi-Format Operator Intake","Phase 1.1 — Brand Vault: Use OR Auto-create + Auto-fill","Path A — BV exists"]},{"path":"commands/business-report.md","name":"business-report","description":"Single-business deep dive — pulls OTTO project data, brand vault, Site Explorer, GBP, PPC, and LLM visibility from SearchAtlas, then presents a structured report with actionable recommendations and saves a markdown record to the client's reports folder.","headings":["/searchatlas:business-report","Instructions","Step 1: Identify the Business","Step 2: Gather Data","Step 3: Present Report","Step 4: Save Local Report"]},{"path":"commands/help.md","name":"help","description":"Command reference — list of all /searchatlas:* commands with descriptions of which SearchAtlas capabilities each one uses.","headings":["/searchatlas:help","Instructions","Output Format"]},{"path":"commands/launch-website.md","name":"launch-website","description":"Plan a complete new-site launch — site architecture, per-page SEO briefs with keywords/metadata/schemas/FAQs, and tracking setup — grounded in live SearchAtlas MCP data. Opinionated toward local service businesses with 1-5 physical locations.","headings":["/searchatlas:launch-website","Two rules that override everything else","Prerequisites","Phase 0 — Identify target","Phase 0.5 — Existence check + pillar scores","Phase 1 — Brand vault auto-pull, or manual collection","Path A — vault exists","Path B — no vault"]},{"path":"commands/my-account.md","name":"my-account","description":"Account overview — lists all OTTO projects, brand vaults, GBP locations, PPC campaigns, content artifacts, and AI visibility projects across the user's SearchAtlas account, with quota summary.","headings":["/searchatlas:my-account","Instructions","Step 1: OTTO Projects","Step 2: Brand Vaults","Step 3: GBP Locations","Step 4: PPC Businesses","Step 5: PPC Campaigns","Step 6: Content"]},{"path":"commands/onboard-client.md","name":"onboard-client","description":"Guided wizard to onboard a new client into SearchAtlas. Supports two paths — pulling full brand data automatically from an existing SearchAtlas brand vault, or building one from manual input. Sets up the client's local working directory with a canonical brand-profile.md and CLAUDE.md, and keeps local files and SearchAtlas in sync from day one.","headings":["/searchatlas:onboard-client","Instructions","Phase 0: Choose Onboarding Path","Path A — Existing Client (Brand Vault Pull)","A1: Select Client From Account","A2: Full Brand Vault Pull (4 parallel calls)","A3: Confirm — Member Reviews and Edits","A4: Confirmation Block"]},{"path":"commands/rebuild-website.md","name":"rebuild-website","description":"Refresh or regenerate an existing website via SearchAtlas Website Studio — consumes scout diagnostic output as source of truth, executes the redesign/migration layer, and publishes the rebuilt site via MCP.","headings":["/searchatlas:rebuild-website","Prerequisites","Spec reference","Phase 0 — Identify Target + Ingest Scout Output","Parse scout output","Validate freshness","Phase 1 — SA Asset Inheritance + Operator Control","OTTO issue clusters (parallel)"]},{"path":"commands/run-content.md","name":"run-content","description":"Content generation pipeline — topical maps, article drafting, brand-vault-driven voice profile, publication scheduling via SearchAtlas Content Genius.","headings":["/searchatlas:run-content","Instructions","Step 1: Choose Starting Point","Creating a New Topical Map","Generating Articles","Optional: Content Grading","Optional: Publishing","Final Step: Save Workflow Log"]},{"path":"commands/run-gbp.md","name":"run-gbp","description":"GBP optimization workflow using SearchAtlas's GBP suite — covers location audit, AI-powered recommendations, posts generation, reviews automation, citations, and photo management for both first-time setup and monthly maintenance.","headings":["/searchatlas:run-gbp","Instructions","Step 1: Choose Mode","First-Time Optimization","Monthly Maintenance","Final Step: Save Workflow Log","Output Format","Golden Rules"]},{"path":"commands/run-ppc.md","name":"run-ppc","description":"PPC campaign setup and maintenance using SearchAtlas's PPC tools — syncs with Google Ads, builds keyword clusters, generates ad content, launches Smart Ads campaigns, and reviews performance metrics.","headings":["/searchatlas:run-ppc","Instructions","Step 1: Collect Campaign Info","Step 2: Execute Workflow","Step 3: Confirm Before Activation","Final Step: Save Workflow Log","Output Format","Golden Rules"]},{"path":"commands/run-pr.md","name":"run-pr","description":"Authority building — press release drafting and distribution via SearchAtlas Press platform; backlink acquisition through cloud stacks and digital PR outreach campaigns.","headings":["/searchatlas:run-pr","Instructions","Step 1: Choose Components","Press Release Workflow","Cloud Stack Workflow","Digital PR Workflow","Optional: Monitor Backlinks","Final Step: Save Workflow Log"]},{"path":"commands/run-seo.md","name":"run-seo","description":"Monthly SEO workflow using SearchAtlas's holistic SEO scoring, OTTO recommendations, content health checks, indexer status, and keyword tracking — covers both new client onboarding and ongoing monthly maintenance.","headings":["/searchatlas:run-seo","Instructions","Step 1: Choose Mode","New Client Onboarding","Monthly Maintenance","Final Step: Save Workflow Log","Output Format","Golden Rules"]},{"path":"commands/run-visibility.md","name":"run-visibility","description":"AI visibility audit — brand mentions across ChatGPT, Claude, Gemini, Perplexity; sentiment, share of voice, and citation tracking via SearchAtlas's LLM Visibility tool.","headings":["/searchatlas:run-visibility","Instructions","Step 1: Collect Info","Step 2: Execute Workflow","Step 3: Recommendations","Final Step: Save Workflow Log","Output Format","Golden Rules"]},{"path":"commands/scout.md","name":"scout","description":"Read-only diagnostic across SEO, GBP, PPC, content, and AI visibility. Uses SearchAtlas's holistic SEO scoring, Site Explorer, GBP audit, and AI visibility tools to give you a full picture and prioritized actions. Creates a SearchAtlas Report Builder report and saves a local HTML record.","headings":["/searchatlas:scout","Instructions","Phase 1: Identify Target","Phase 2: Existence Check (no creation)","Phase 3: Parallel Discovery","Phase 4: Score Each Pillar","Phase 5: Build Action Plan","Phase 6: Render Chat Output"]},{"path":"commands/security-scan.md","name":"security-scan","description":"Scan any Git repository for security risks before running it on your machine — works immediately with zero tools installed, gets more thorough as better tools become available, always produces a plain-English verdict.","headings":["/searchatlas:security-scan","Instructions","Step 0: Greet and Parse Input","Step 1: Detect What Tools Are Available","Step 1b: Auto-Install Security Tools (if user agrees)","Step 2: Surface Check (Always runs — no tools needed)","Get metadata — works for any public GitHub repo","Check package.json for dangerous install hooks"]},{"path":"commands/send-circle.md","name":"send-circle","description":"Post to Circle space via Circle API v2. API key from CIRCLE_API_KEY.","headings":["/searchatlas:send-circle","Instructions","Prerequisites","Step 1: Choose Space","Step 2: Compose Post","Step 3: Send","Step 4: Confirm","Output Format"]},{"path":"commands/send-discord.md","name":"send-discord","description":"Post results to Discord via webhook. Webhook URL from DISCORD_WEBHOOK_URL env var.","headings":["/searchatlas:send-discord","Instructions","Prerequisites","Step 1: Compose Message","Step 2: Format Message","Step 3: Send","Step 4: Confirm","Output Format"]},{"path":"commands/send-email.md","name":"send-email","description":"Email results via the Resend REST API. Free tier 100/day. API key from RESEND_API_KEY, sender from EMAIL_FROM.","headings":["/searchatlas:send-email","Instructions","Prerequisites","Step 1: Collect Details","Step 2: Format Body","Step 3: Send","Step 4: Confirm","Output Format"]},{"path":"commands/send-slack.md","name":"send-slack","description":"Post results to Slack via Incoming Webhooks. Supports multiple named channels via SLACK_WEBHOOK_{NAME} env vars (e.g., SLACK_WEBHOOK_SEO, SLACK_WEBHOOK_PPC). Default channel uses SLACK_WEBHOOK_URL.","headings":["/searchatlas:send-slack","Instructions","Prerequisites","Step 0: Channel Selection (multi-channel)","Step 1: Compose Message","Step 2: Format Message","Step 3: Send","Use the webhook URL from the selected channel (default: SLACK_WEBHOOK_URL)"]},{"path":"commands/setup-integrations.md","name":"setup-integrations","description":"Interactive wizard to connect your existing tools (HubSpot, ClickUp, Linear, Notion, Slack, Gmail, Google Calendar, GitHub) to Claude Code — guides through OAuth flows and API token setup one integration at a time.","headings":["/searchatlas:setup-integrations","Instructions for Claude","Phase 1 — Discovery","Phase 2 — Setup (one at a time)","Phase 3 — Summary","Notes"]},{"path":"commands/summit-shot.md","name":"summit-shot","description":"Atomic single-play executor for the 19 plays taught at the SearchAtlas Summit. Intentionally bounded by default — 1 article draft, 1 PR draft, no auto-deploys. Use /searchatlas:summit-shot {N} to run a specific play directly. Complements /searchatlas:scout — scout says what to run, summit-shot runs it.","headings":["/searchatlas:summit-shot","Instructions","Phase 1: Pick a Play","Phase 2: Resolve Context","Phase 3: Execute the Play","Phase 4: Save Run Record","Play {NN} — {play_name}","Phase 5: Suggest Next Move"]},{"path":"commands/sync-client.md","name":"sync-client","description":"Two-way sync between a client's local brand-profile.md and their SearchAtlas brand vault. Push local changes up to SearchAtlas, pull remote updates down to the local file, or run a full bidirectional sync. Modifies the existing brand-profile.md in place — no new output files are created.","headings":["/searchatlas:sync-client [client-slug]","Instructions","Step 1: Id