{"file":"boomi-data-integration-0.2.3-v1.zip","bytes":99711,"status":"已读取","plugins":[{"path":".claude-plugin/plugin.json","name":"bc-bdi","description":"Operates Boomi Data Integration (BDI, formerly Rivery) — the ELT/ETL data-pipeline product that loads and transforms data in a data warehouse or lake.","version":"0.2.3"}],"skills":[{"path":"skills/boomi-bdi/SKILL.md","name":"boomi-bdi","description":"Operates BDI (Boomi Data Integration, formerly Rivery) — the ELT data-pipeline product: it ingests and CDC-replicates sources into a data warehouse or lake, transforms within it (SQL/Python), and activates data back out (reverse ETL). Use for BDI, Rivery, data flow, river, ELT, CDC, and reverse-ETL requests. Not for application integration — connecting apps, APIs, queues, or trading partners (EDI) to run a business process or keep systems in sync (use boomi-integration, the general-purpose iPaaS); not Boomi Flow's human-facing workflow/approval apps, a different product despite the shared word 'flow' (use boomi-flow); not master-data management such as golden records, matching, or stewardship (use boomi-datahub).","headings":["boomi-bdi","Scope","Capabilities","Terminology","Disambiguation: neighboring Boomi products","Credentials","First-run setup","Mutations: confirm before writing","Scripts inventory","Platform behavior","References","Connections: resolve with the user","Creating assets"],"name_hint":"boomi · bdi"}],"commands":[],"readmes":[{"path":"README.md","headings":["bc-bdi","Feedback & Issues","Setup","BDI documentation"]},{"path":"skills/boomi-bdi/README.md","headings":["boomi-bdi","Feedback & Issues","Setup"]}],"mcp_servers":[],"config_names":[],"paths":[".claude-plugin/plugin.json",".gitignore","CHANGELOG.md","CLAUDE.md","LICENSE","README.md","changes/.gitkeep","skills/boomi-bdi/CHANGELOG.md","skills/boomi-bdi/CLAUDE.md","skills/boomi-bdi/LICENSE","skills/boomi-bdi/README.md","skills/boomi-bdi/SKILL.md","skills/boomi-bdi/VERSION","skills/boomi-bdi/referen